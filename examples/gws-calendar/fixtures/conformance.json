          "expect": "expired",
          "asserts": [
            {
              "action": "gws.read",
              "resource": "sam.rivera@example.com:calendar.events.list"
            }
          ],
          "refuses": "CURSOR_EXPIRED: Google no longer keeps the history this cursor names. Next step: read again with since to restart the window.",
