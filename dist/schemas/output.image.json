{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "maxLength": 2048
    },
    "dataUri": {
      "type": "string",
      "maxLength": 1044480,
      "pattern": "^data:image\\/(png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}$"
    },
    "alt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "caption": {
      "type": "string",
      "maxLength": 120
    }
  },
  "required": [
    "alt"
  ],
  "additionalProperties": false
}
