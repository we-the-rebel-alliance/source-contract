          }
        },
        {
          "name": "a sync token Google has forgotten is CURSOR_EXPIRED",
          "input": {
            "source": "calendar",
            "account": "sam.rivera@example.com",
            "cursor": "calendar:sam.rivera@example.com:sync:sync-expired"
