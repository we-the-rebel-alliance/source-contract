{
  "name": "@joe-broadhead/opencode-slack",
  "version": "0.0.0-example",
  "description": "An example: the sources Slack declares under contract version 1. Not the plugin; its package.json is the one that ships.",
  "private": true,
  "sources": {
    "contractVersion": 1,
    "items": [
      {
        "id": "slack.channels",
        "kind": "events",
        "reads": "message",
        "tool": "events_list",
        "input": { "source": "slack" },
        "accounts": { "named": false },
        "scope": { "keys": ["channels"], "describe": "Which channels and direct messages" },
        "details": [
          {
            "id": "slack.thread",
            "tool": "slack_read_thread",
            "from": ["thread_channel", "thread_ts"],
            "within": "channels",
            "permission": { "tool": "slack_slack_read_thread" }
          }
        ],
        "permission": {
          "events": "slack_events_list",
          "operations": ["slack_slack_read_user_profile", "slack_slack_read_channel"]
        },
        "private": true,
        "cost": { "class": "free" },
        "maxBytes": 262144,
        "urlHosts": ["slack.com", "*.slack.com"]
      }
    ]
  }
}
