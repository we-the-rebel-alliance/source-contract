{
  "name": "@joe-broadhead/opencode-slack",
  "version": "0.0.0-example",
  "description": "A test descriptor in the shape of Memory's examples: not the plugin.",
  "private": true,
  "sources": {
    "contractVersion": 1,
    "items": [
      {
        "id": "slack.workspace",
        "kind": "events",
        "reads": "message",
        "tool": "events_list",
        "accounts": { "named": false },
        "scope": {
          "keys": ["channels"],
          "describe": "Channels and direct messages to read.",
          "suggest": { "tool": "slack_list_user_channels", "operations": ["slack_list_user_channels"] }
        },
        "details": [{ "id": "slack.workspace.thread", "tool": "slack_read_thread", "from": ["thread"] }],
        "permission": { "events": "slack_events_list", "operations": ["slack_read_channel", "slack_read_thread"] },
        "private": true,
        "cost": { "class": "free" },
        "maxBytes": 262144,
        "urlHosts": ["*.slack.com"]
      }
    ]
  }
}
