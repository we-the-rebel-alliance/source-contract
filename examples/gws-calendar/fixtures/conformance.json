          "name": "a scope key this source does not declare is refused",
          "input": {
            "source": "calendar",
            "account": "sam.rivera@example.com",
            "scope": {
              "labels": [
                "INBOX"
              ]
            }
          },
          "expect": {
            "refuses": "SCOPE_UNKNOWN"
