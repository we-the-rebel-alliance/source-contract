{
  "name": "@joe-broadhead/opencode-gws",
  "version": "0.0.0-example",
  "description": "An example: the sources Google Workspace (gws) declares under contract version 1. Not the plugin; its package.json is the one that ships.",
  "private": true,
  "sources": {
    "contractVersion": 1,
    "items": [
      {
        "id": "gws.gmail",
        "kind": "events",
        "reads": "message",
        "tool": "events_list",
        "input": {
          "source": "gmail"
        },
        "accounts": {
          "named": true
        },
        "scope": {
          "keys": [
            "labels"
          ],
          "describe": "Which labels"
        },
        "details": [
          {
            "id": "gws.gmail.message",
            "tool": "read",
            "from": [
              "external_id"
            ]
          }
        ],
        "permission": {
          "events": "gws.events_list",
          "operationAction": "gws.read",
          "operations": [
            "gmail.users.history.list",
            "gmail.users.messages.list",
            "gmail.users.messages.get"
          ]
        },
        "private": true,
        "cost": {
          "class": "free"
        },
        "maxBytes": 262144,
        "retentionDays": 30,
        "urlHosts": [
          "mail.google.com"
        ]
      },
      {
        "id": "gws.calendar.today",
        "kind": "snapshot",
        "tool": "calendar_today",
        "output": "agenda",
        "params": {
          "window": {
            "relative": true
          }
        },
        "accounts": {
          "named": true
        },
        "permission": {
          "tool": "gws.calendar_today",
          "operationAction": "gws.read",
          "operations": [
            "calendar.events.list"
          ]
        },
        "private": true,
        "cost": {
          "class": "free"
        },
        "maxAgeSec": 900,
        "maxBytes": 65536
      }
    ]
  }
}
