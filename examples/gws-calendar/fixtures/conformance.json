          "input": {
            "source": "calendar",
            "account": "sam.rivera@example.com"
          },
          "expect": "page",
          "asserts": [
            {
              "action": "gws.events_list",
              "resource": "*"
            },
            {
              "action": "gws.read",
              "resource": "sam.rivera@example.com:calendar.calendarList.get"
            },
            {
              "action": "gws.read",
              "resource": "sam.rivera@example.com:calendar.events.list"
            }
          ],
          "answer": {
            "source": "gws.calendar",
            "plugin": "@joe-broadhead/opencode-gws",
            "account": "sam.rivera@example.com",
            "owner": {
              "id": "mailto:sam.rivera@example.com",
              "label": "Sam Rivera"
            },
            "asOf": "2026-11-13T09:00:00.000Z",
            "trust": "untrusted",
            "events": [
