{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "fields": {
      "minItems": 1,
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 60
          },
          "value": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "fields"
  ],
  "additionalProperties": false
}
