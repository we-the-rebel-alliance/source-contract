{
  "$comment": "Sanitised from the off-line gws pilot fixture: every address, meeting and id is invented. Recorded as contract-version-1 page results, with page tokens, sync tokens, a 410 and a cancellation. The kit replays each case by its input exactly.",
  "plugin": "@joe-broadhead/opencode-gws",
  "account": "sam.rivera@example.com",
  "tools": [
    {
      "id": "events_list",
      "readOnly": true
    },
    {
      "id": "calendar_today",
      "readOnly": true
    }
  ],
  "sources": {
    "gws.calendar": {
