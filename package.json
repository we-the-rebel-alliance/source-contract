{
  "name": "@we-the-rebel-alliance/plugin-contract",
  "version": "0.0.0",
  "description": "The contract between OpenCode plugins and the apps that use them: one manifest, one data model, one error table, and the library that reads all three.",
  "license": "MIT",
  "bin": {
    "plugin-kit": "./bin/plugin-kit.js"
  },
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/we-the-rebel-alliance/plugin-contract.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./access": {
      "types": "./dist/access.d.ts",
      "default": "./dist/access.js"
    },
    "./accounts": {
      "types": "./dist/accounts.d.ts",
      "default": "./dist/accounts.js"
    },
    "./act": {
      "types": "./dist/act.d.ts",
      "default": "./dist/act.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "default": "./dist/audit.js"
    },
    "./bus": {
      "types": "./dist/bus.d.ts",
      "default": "./dist/bus.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    },
    "./cursor": {
      "types": "./dist/cursor.d.ts",
      "default": "./dist/cursor.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./grant": {
      "types": "./dist/grant.d.ts",
      "default": "./dist/grant.js"
    },
    "./hints": {
      "types": "./dist/hints.d.ts",
      "default": "./dist/hints.js"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "default": "./dist/kit.js"
    },
    "./outputs": {
      "types": "./dist/outputs.d.ts",
      "default": "./dist/outputs.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./params": {
      "types": "./dist/params.d.ts",
      "default": "./dist/params.js"
    },
    "./pick": {
      "types": "./dist/pick.d.ts",
      "default": "./dist/pick.js"
    },
    "./read": {
      "types": "./dist/read.d.ts",
      "default": "./dist/read.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run test:node",
    "test:node": "node --test \"test/**/*.test.ts\"",
    "test:bun": "bun test ./test",
    "check:dist": "node scripts/check-dist.mjs",
    "conformance:self-test": "node scripts/conformance-self-test.mjs",
    "check": "npm run typecheck && npm run build && npm run check:dist && npm test && npm run conformance:self-test"
  },
  "devDependencies": {
    "@opencode/plugin": "2.4.1",
    "@opencode/sdk": "2.4.1",
    "@types/node": "24.19.2",
    "effect": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  }
}
